# Supabase — get from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions env vars — configure in Supabase Dashboard → Settings → Edge Functions
# (these are NOT exposed to the frontend — server-side only)

# TextBee — https://textbee.dev (free, no CNPJ needed)
# SMS is sent from your Android phone's SIM card — shows a real Brazilian number
# Setup:
#   1. Create account at textbee.dev
#   2. Install TextBee app on Android phone and grant SMS permissions
#   3. Register device in dashboard → copy DEVICE_ID
#   4. Generate API key in dashboard → copy API_KEY
# TEXTBEE_API_KEY=your-api-key
# TEXTBEE_DEVICE_ID=your-device-id

# Supabase service role (auto-injected in Edge Functions — no action needed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
