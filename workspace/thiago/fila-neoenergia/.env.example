# Supabase — get from https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions env vars — configure in Supabase Dashboard → Settings → Edge Functions
# (these are NOT exposed to the frontend — server-side only)

# Twilio — https://console.twilio.com (free trial, no CNPJ needed)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+12015551234   ← number from Twilio console

# Supabase service role (auto-injected in Edge Functions — no action needed)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
